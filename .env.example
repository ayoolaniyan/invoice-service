# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Required
DATABASE_CONNECTION_STRING=mongodb://127.0.0.1:27017
DATABASE_NAME=invoice_service
PORT=3001
# Comma-separated name:role:sha256-hash entries. Create one with: npm run api-key:generate -- <name> <read|write>
API_KEYS=

# Optional
# NODE_ENV=production
# LOG_LEVEL=info                      # fatal, error, warn, info, debug, trace or silent
# CORS_ORIGINS=http://localhost:5173  # comma-separated browser origins allowed to call the API
# RATE_LIMIT_MAX=300                  # requests per client IP per window
# RATE_LIMIT_WINDOW_MS=900000         # 15 minutes
# TRUST_PROXY=1                       # number of proxies in front of the app
# ENABLE_API_DOCS=true                # force the Swagger UI on or off
