{
  "name": "invoice-service",
  "version": "1.0.0",
  "description": "REST API for managing companies and their invoices",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:dev": "nodemon index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:coverage": "jest --coverage",
    "check": "npm run lint && npm run typecheck && npm test",
    "migrate:backfill-company-id": "ts-node scripts/backfill-invoice-company-id.ts",
    "migrate:amounts-to-minor-units": "ts-node scripts/convert-invoice-amounts-to-minor-units.ts",
    "api-key:generate": "ts-node scripts/generate-api-key.ts"
  },
  "author": "Olaniyan A . O",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "inversify": "^6.2.2",
    "mongoose": "^8.10.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.8",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
